# Hyperliquid Market Making Bot Configuration
# Copy this file to secrets.env and fill in your values

# ============================================
# REQUIRED SETTINGS
# ============================================

PRIVATE_KEY=your_private_key_here
TESTNET=True

# ============================================
# STRATEGY PARAMETERS
# ============================================

SYMBOL=ETH
SPREAD_PCT=0.002
ORDER_SIZE=0.01
MAX_POSITION=0.05
REFRESH_INTERVAL=10

# ============================================
# RISK MANAGEMENT
# ============================================

MAX_POSITION_VALUE=1000.0
MAX_DRAWDOWN_PCT=0.10

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO
LOG_DIR=logs

